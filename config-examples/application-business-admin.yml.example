# Copy to .local/application-business-admin.yml; contains system datasource override.
spring:
  datasource:
    url: ${ADMIN_DB_URL}
    username: ${ADMIN_DB_USERNAME}
    password: ${ADMIN_DB_PASSWORD}
  quartz:
    job-store-type: memory
    auto-startup: false
acq:
  datasource:
    url: ${ACQ_DB_URL}
    username: ${ACQ_DB_USERNAME}
    password: ${ACQ_DB_PASSWORD}
token:
  secret: ${JWT_SECRET}
ruoyi:
  profile: ${UPLOAD_DIR}
