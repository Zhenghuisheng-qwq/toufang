# Copy outside Git or to jsj-mini/src/main/resources/application-local.yml (ignored).
# Set BOOT_DB_URL to the authorized toufang JDBC URL and BOOT_DB_USERNAME/PASSWORD.
# Do not start Mini just to check a build: its Netty lifecycle also starts.
spring:
  datasource:
    url: ${BOOT_DB_URL}
    username: ${BOOT_DB_USERNAME}
    password: ${BOOT_DB_PASSWORD}
  data:
    redis:
      host: ${REDIS_HOST}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      database: ${REDIS_DATABASE:1}
acq:
  report:
    worker:
      enabled: false
  pay:
    live: false
