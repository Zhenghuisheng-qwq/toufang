/* pages/index/index.wxss */
.container {
  padding: 120rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #2979ff;
  color: #fff;
  font-size: 64rpx;
  line-height: 160rpx;
  text-align: center;
  margin-bottom: 30rpx;
}
.avatar-img {
  background: #f2f2f2;
}
.nickname {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
}

.logout-btn {
  background: #fff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
