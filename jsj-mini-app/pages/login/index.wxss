/* pages/login/index.wxss */
.login {
  padding: 120rpx 60rpx;
  text-align: center;
}
.logo {
  font-size: 90rpx;
  font-weight: 700;
  color: #2979ff;
  margin-bottom: 160rpx;
}
.tip {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 80rpx;
}
.login-btn {
  background: #2979ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  height: 90rpx;
  line-height: 90rpx;
}
.login-btn[disabled] {
  background: #90b8ff;
  color: #fff;
}
